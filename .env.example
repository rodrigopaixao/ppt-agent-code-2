# Never commit a real key. Copy this file to .env and fill it locally.
# The service calls Gemini through OpenRouter.
OPENROUTER_API_KEY=<API_KEY>
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PPTX_TEMPLATE_PATH=assets/templates/client-a-template.pptx
PPTX_DATA_DIR=data
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
