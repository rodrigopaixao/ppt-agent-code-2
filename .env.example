# Never commit a real key. Copy this file to .env and fill it locally.
# Use an OpenRouter key. The service calls OpenRouter's Anthropic-compatible API.
ANTHROPIC_API_KEY=<API_KEY>
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_MODEL=anthropic/claude-sonnet-4.5
PPTX_TEMPLATE_PATH=assets/templates/client-a-template.pptx
PPTX_DATA_DIR=data
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
